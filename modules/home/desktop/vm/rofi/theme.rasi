configuration {
    modi: "drun,run,filebrowser,window";
    show-icons: true;
    font: "Adwaita Sans, Inter, sans-serif 12";
    terminal: "alacritty";
    run-shell-command: "{terminal} -e {cmd}";
    drun-display-format: "{name}";
}

@theme "/dev/null"

* {
    bg-col: #2e2e32f5;
    bg-col-light: #38383e;
    border-col: #45454a;
    selected-col: #3584e4;
    text-col: #ffffff;
    grey: #8e8e93;

    width: 768px;
    background-color: transparent;
    text-color: @text-col;
}

window {
    background-color: @bg-col;
    border: 4px;
    border-color: @border-col;
    border-radius: 12px;
    padding: 14px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 8px;
}

inputbar {
    background-color: @bg-col-light;
    border-radius: 12px;
    padding: 8px 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @selected-col;
    padding: 0px 6px 0px 0px;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search...";
    placeholder-color: @grey;
    vertical-align: 0.5;
}

listview {
    lines: 5;
    columns: 1;
    spacing: 4px;
    fixed-height: false;
}

element {
    padding: 6px 10px;
    border-radius: 12px;
    spacing: 10px;
    children: [ element-icon, element-text ];
}

element-icon {
    size: 22px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

element selected {
    background-color: @selected-col;
    text-color: #ffffff;
}
